# .env.example

# Environment: development, staging, production
ENVIRONMENT=development

# Database
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgres://podry:${POSTGRES_PASSWORD}@postgres:5432/podry?sslmode=disable
# Optional separate owner connection, used only by `podry migrate up|down`.
DATABASE_MIGRATION_URL=

# Independent AES-256-GCM credential key: Base64 of 32 random bytes.
# Keep stable and back it up with the database. Empty disables credential writes.
PODRY_CREDENTIAL_KEY=

# B4 CI worker: enable only after registering the build cluster and Registry.
# Runner must be the controlled tools/build-runner image pinned by digest.
PODRY_BUILD_ENABLED=false
# Development only: comma-separated exact host:port pairs for HTTP Git/Registry.
# Example: localhost:3000,localhost:5000; use Pod-reachable hosts for Kubernetes CI.
PODRY_HTTP_ALLOWED_HOSTS=
PODRY_BUILD_CLUSTER_ID=
PODRY_BUILD_NAMESPACE=
PODRY_BUILDKIT_ADDR=
PODRY_BUILD_RUNNER_IMAGE=
PODRY_BUILD_PLATFORM=linux/amd64
PODRY_BUILD_CONCURRENCY=1
# B5 release worker: remains disabled until cluster/CD acceptance is scheduled.
PODRY_RELEASE_ENABLED=false
PODRY_RELEASE_CONCURRENCY=1
# API + worker share this persistent directory; archived logs expire after 7 days.
PODRY_DATA_DIR=.podry
# Shared deadline for HTTP requests, claimed worker steps and database close.
PODRY_SHUTDOWN_TIMEOUT=30s
# Container grace must exceed PODRY_SHUTDOWN_TIMEOUT (also when overriding it).
PODRY_STOP_GRACE_PERIOD=45s

# JWT Configuration
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION
# V1 ignores the two JWT_REFRESH_* compatibility settings; no Refresh Token endpoint.
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=168h

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text
