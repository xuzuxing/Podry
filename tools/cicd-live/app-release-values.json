{
  "section": "base",
  "chartConfig": {
    "workloadKind": "Deployment",
    "chartVersion": "1.1.0"
  },
  "deployValues": {
    "replicaCount": 1,
    "containerPort": 8080,
    "resources": {
      "requests": { "cpu": "25m", "memory": "32Mi" },
      "limits": { "cpu": "250m", "memory": "128Mi" }
    },
    "service": { "enabled": true, "port": 80 },
    "ingress": {
      "enabled": true,
      "host": "app.podry.dev",
      "className": "traefik",
      "tlsSecretName": "podry-demo-live-tls",
      "clusterIssuer": "podry-test-ca"
    }
  },
  "secretRefs": []
}
